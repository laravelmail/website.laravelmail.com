---
import Layout from "../layouts/Layout.astro";
import { pricing } from "../config/pricing";
---
<Layout title="Request Early Access | Laravel Mail" description="Free core + £50 one-time add-on bundle. Request alpha access via email.">
<section class="pt-32 pb-20 bg-brand-bg">
<div class="container-custom max-w-3xl mx-auto text-center">
<h1 class="text-4xl md:text-5xl font-black text-white mb-4">Request <span class="gradient-text">Early Access</span></h1>
<p class="text-lg text-gray-400 mb-8">We're in alpha – capacity is limited. To request access, please email us at <a href={pricing.mailto} class="text-brand-primary underline">{pricing.earlyAccessEmail}</a> with your name, company, and use case. We'll review and get back to you within 48 hours.</p>
<div class="bg-white/5 border border-white/10 rounded-2xl p-8 text-left mb-8">
<p class="text-sm text-gray-300 mb-4"><strong class="text-white">Free core</strong> – open-source self-hosted engine. <strong class="text-white">Add-on Bundle £50 one-time</strong> – includes Leads Database + Validation API credits.</p>
<a href={pricing.mailto} class="btn btn-primary w-full text-center">Email {pricing.earlyAccessEmail}</a>
<p class="text-xs text-gray-500 mt-3 text-center">Subject: {pricing.earlyAccessSubject}</p>
</div>
<p class="text-xs text-gray-500">Or email directly: <a href={pricing.mailto} class="underline">{pricing.mailto}</a></p>
</div>
</section>
