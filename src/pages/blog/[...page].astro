---
import { getCollection } from 'astro:content';
import Layout from "../../layouts/Layout.astro";
import CTASection from "../../components/CTASection.astro";
import BlogListing from "../../components/BlogListing.astro";
import { injectSeoLinks } from "../../scripts/seo-utils";
import { marked } from 'marked';

export const prerender = true;

export async function getStaticPaths({ paginate }) {
    const posts = await getCollection('blog');
    const sortedPosts = posts.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

    const paginated = paginate(sortedPosts, { pageSize: 12 });

    const postRoutes = posts.map(post => ({
        params: { page: post.id.replace('.json', '') },
        props: { post },
    }));

    return [...paginated, ...postRoutes];
}

const { page, post } = Astro.props;
---

{post ? (
    <Layout title={`${post.data.title} | Laravel Mail Blog`} description={post.data.excerpt}>
        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "BlogPosting",
            "headline": post.data.title,
            "description": post.data.excerpt,
            "image": post.data.image,
            "datePublished": post.data.date,
            "dateModified": post.data.date,
            "author": { "@type": "Person", "name": post.data.author, "jobTitle": post.data.authorRole },
            "publisher": { "@type": "Organization", "name": "Laravel Mail", "logo": { "@type": "ImageObject", "url": "https://laravelmail.com/logo.svg" } },
            "mainEntityOfPage": { "@type": "WebPage", "@id": Astro.url.href },
            "keywords": post.data.tags.join(", "),
            "articleSection": "Email Marketing"
        })} />
        <article class="pt-32 pb-20 bg-brand-bg">
            <div class="container-custom">
                <div class="max-w-4xl mx-auto mb-12 text-center">
                    <div class="flex items-center justify-center gap-4 mb-6">
                        {post.data.tags.map((tag: string) => (
                            <span class="text-xs font-bold uppercase tracking-wider text-brand-primary px-3 py-1 bg-brand-primary/10 rounded-full border border-brand-primary/20">
                                {tag}
                            </span>
                        ))}
                        <span class="text-xs text-gray-500">{post.data.date}</span>
                    </div>
                    <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-white mb-8 leading-tight">
                        {post.data.title}
                    </h1>
                    <div class="flex items-center justify-center gap-4">
                        <img src="https://avatars.githubusercontent.com/u/2276408?v=4" alt={post.data.author} class="w-12 h-12 rounded-full border-2 border-brand-primary" />
                        <div class="text-left">
                            <p class="text-white font-bold">{post.data.author}</p>
                            <p class="text-gray-400 text-sm">{post.data.authorRole}</p>
                        </div>
                    </div>
                </div>

                <div class="max-w-5xl mx-auto mb-16 rounded-3xl overflow-hidden shadow-2xl shadow-brand-primary/20">
                    <img src="/logo.svg" alt={post.data.title} class="w-full h-auto" />
                </div>

                <div class="max-w-3xl mx-auto">
                    <div class="prose prose-invert prose-lg max-w-none 
                        prose-headings:text-white prose-headings:font-bold
                        prose-p:text-gray-300 prose-p:leading-relaxed
                        prose-li:text-gray-300
                        prose-strong:text-white prose-strong:font-bold
                        prose-a:text-brand-primary prose-a:no-underline hover:prose-a:underline
                        prose-img:rounded-2xl
                        prose-blockquote:border-l-brand-primary prose-blockquote:bg-white/5 prose-blockquote:py-2 prose-blockquote:px-8 prose-blockquote:rounded-r-xl">
                        <Fragment set:html={injectSeoLinks(marked.parse(post.data.content) as string)} />
                    </div>

                    <div class="mt-16 pt-8 border-t border-white/10 flex flex-wrap gap-2">
                        <span class="text-white font-bold mr-2">Tags:</span>
                        {post.data.tags.map((tag: string) => (
                            <span class="text-sm text-gray-400">#{tag}</span>
                        ))}
                    </div>
                </div>
            </div>
        </article>
        <CTASection />
    </Layout>

    <style is:global>
        .prose .lead-paragraph p {
            @apply text-xl text-gray-200 leading-relaxed italic border-l-4 border-brand-primary pl-6 mb-8;
        }
        .prose .highlight-box {
            @apply bg-brand-primary/10 p-8 rounded-2xl my-10 border border-brand-primary/20;
        }
        .prose .feature-box {
            @apply bg-black/30 p-8 rounded-2xl my-10 border border-white/10 shadow-xl;
        }
        .prose .feature-grid {
            display: grid;
            @apply grid-cols-1 md:grid-cols-2 gap-6 my-10;
        }
        .prose .feature-card {
            @apply bg-white/5 p-6 rounded-xl border border-white/10 hover:border-brand-primary/30 transition-colors;
        }
        .prose .security-box {
            @apply bg-brand-primary/5 p-8 rounded-2xl my-10 border border-brand-primary/20;
        }
        .prose .approach-section .grid {
            display: grid;
            @apply grid-cols-1 md:grid-cols-3 gap-6 my-10;
        }
        .prose .approach-section .bg-white {
            @apply bg-white/5 border border-white/10 p-6 rounded-xl text-gray-300;
        }
        .prose .metrics-section ul {
            @apply space-y-4 list-none pl-0;
        }
    </style>
) : (
    <Layout title="Email Marketing Blog | Laravel Mail - Insights & Automation Guides" description="Master email marketing, deliverability, and automation. Expert guides and technical insights for Laravel developers and SaaS founders.">
        <BlogListing page={page} />
    </Layout>
)}
